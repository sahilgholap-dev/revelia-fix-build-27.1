{
  "name": "revelia-backend",
  "version": "2.0.0",
  "description": "Backend API for Revelia - AI-powered face and palm reading app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "check:prose": "ts-node --transpile-only src/scripts/check-prose-sanitiser.ts",
    "check:tier": "ts-node --transpile-only src/scripts/effective-tier.check.ts",
    "check:ailog": "ts-node --transpile-only src/scripts/ai-generation-log.check.ts",
    "check:cors": "ts-node --transpile-only src/scripts/cors-origins.check.ts",
    "migrate:date-format": "ts-node --transpile-only src/scripts/migrate-monthly-reading-date-format.ts",
    "migrate:date-format:dry": "ts-node --transpile-only src/scripts/migrate-monthly-reading-date-format.ts --dry-run",
    "backfill:geocode": "ts-node --transpile-only src/scripts/backfill-geocode.ts",
    "backfill:geocode:dry": "ts-node --transpile-only src/scripts/backfill-geocode.ts --dry-run",
    "backfill:daily-insight-tz": "ts-node --transpile-only src/scripts/backfill-daily-insight-tz.ts",
    "backfill:daily-insight-tz:dry": "ts-node --transpile-only src/scripts/backfill-daily-insight-tz.ts --dry-run",
    "backfill:natal-chart": "ts-node --transpile-only src/scripts/backfill-natal-chart.ts",
    "backfill:natal-chart:dry": "ts-node --transpile-only src/scripts/backfill-natal-chart.ts --dry-run",
    "backfill:face-features": "ts-node --transpile-only src/scripts/backfill-face-features.ts",
    "backfill:face-features:dry": "ts-node --transpile-only src/scripts/backfill-face-features.ts --dry-run",
    "backfill:palm-features": "ts-node --transpile-only src/scripts/backfill-palm-features.ts",
    "backfill:palm-features:dry": "ts-node --transpile-only src/scripts/backfill-palm-features.ts --dry-run",
    "backfill:numerology": "ts-node --transpile-only src/scripts/backfill-numerology.ts",
    "backfill:numerology:dry": "ts-node --transpile-only src/scripts/backfill-numerology.ts --dry-run",
    "test:email": "ts-node --transpile-only src/scripts/test-email.ts",
    "test:timing": "ts-node --transpile-only src/scripts/timing-fixtures.check.ts",
    "test:qa-prompt": "ts-node --transpile-only src/scripts/qa-prompt-invariants.check.ts",
    "test:qa-router": "ts-node --transpile-only src/scripts/qa-router-fixtures.check.ts",
    "test:qa-device-gate": "ts-node --transpile-only src/scripts/qa-device-gate.check.ts",
    "grant:comp": "ts-node --transpile-only src/scripts/grant-comp-tier.ts",
    "grant:comp:dry": "ts-node --transpile-only src/scripts/grant-comp-tier.ts --dry-run"
  },
  "keywords": [
    "revelia",
    "api",
    "express",
    "typescript"
  ],
  "author": "Revelia Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@sendgrid/mail": "^8.1.6",
    "@tensorflow-models/hand-pose-detection": "2.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "mongoose": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "sharp": "^0.33.2",
    "sweph": "^2.10.3-5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
