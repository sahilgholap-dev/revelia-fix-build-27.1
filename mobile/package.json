{
  "name": "revelia-mobile",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "gate": "bash scripts/token-gate.sh",
    "web:stamp-sw": "node scripts/stamp-sw.js",
    "web:export": "npm run web:stamp-sw && expo export --platform web && node scripts/flatten-vendor-assets.js && node scripts/verify-export.js",
    "web:export:clear": "npm run web:stamp-sw && expo export --platform web --clear && node scripts/flatten-vendor-assets.js && node scripts/verify-export.js",
    "web:serve": "node scripts/serve-web.js",
    "web:deploy": "npm run web:export && npx wrangler pages deploy dist --project-name revelia-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "axios": "^1.6.8",
    "expo": "^53.0.0",
    "expo-apple-authentication": "~7.2.4",
    "expo-application": "~6.1.5",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-updates": "~0.28.18",
    "nativewind": "^4.1.23",
    "onesignal-expo-plugin": "^2.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-onesignal": "^5.2.0",
    "react-native-purchases": "^9.7.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.11.2",
    "react-native-view-shot": "^4.0.0-alpha.2",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~9.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  },
  "private": true
}
