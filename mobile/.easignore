# EAS Build Ignore File
# Files and directories to exclude from EAS builds

# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/

# Environment files
.env
.env.local
.env.development
.env.staging
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.jest/

# Temporary files
*.tmp
*.temp
.cache/

# Documentation (not needed in builds)
*.md
README.md
HANDOFF.md
SETUP_VERIFICATION.md

# Scripts
verify.sh
